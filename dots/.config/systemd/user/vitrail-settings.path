[Unit]
Description=Watch the Vitrail settings files

[Path]
# One line per file of vitrail/prefs.map (tests/test_prefs_map.py checks it).
# The directory is not watched: apply-settings writes its own files there.
PathChanged=%h/.config/vitrail/appearance.ini
PathChanged=%h/.config/vitrail/colors.ini
PathChanged=%h/.config/vitrail/bar.ini
PathChanged=%h/.config/vitrail/wallpaper.ini
PathChanged=%h/.config/vitrail/background.ini
PathChanged=%h/.config/vitrail/windows.ini
PathChanged=%h/.config/vitrail/monitors.ini
PathChanged=%h/.config/vitrail/input.ini
PathChanged=%h/.config/vitrail/terminal.ini
PathChanged=%h/.config/vitrail/sound.ini
PathChanged=%h/.config/vitrail/fonts.ini
PathChanged=%h/.config/vitrail/capture.ini
PathChanged=%h/.config/vitrail/launcher.ini
PathChanged=%h/.config/vitrail/language.ini
PathChanged=%h/.config/vitrail/datetime.ini
PathChanged=%h/.config/vitrail/connection.ini
PathChanged=%h/.config/vitrail/misc.ini
Unit=vitrail-settings.service
TriggerLimitIntervalSec=1
TriggerLimitBurst=50

[Install]
WantedBy=default.target

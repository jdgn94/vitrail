# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
sdist/

# --- Virtual environment (uv) ---
.venv/
venv/
env/
# uv.lock and .python-version ARE versioned: they reproduce the exact env.

# --- Tool caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# --- graphify graph (regenerated) ---
graphify-out/
.graphify-cache/
*.graph.json.tmp

# --- Vitrail installer ---
# Backups created by ./install.sh before touching $HOME
.backup/
*.log

# --- Qt / QML ---
*.qmlc
*.jsc
.qmake.stash
CMakeCache.txt
CMakeFiles/

# --- Secrets and local overrides ---
.env
.env.*
!.env.example
*.local

# --- Editors ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Operating system ---
.DS_Store
Thumbs.db
desktop.ini

# --- Patches and merge leftovers ---
*.orig
*.rej

# --- Bundled wallpapers ---
# Large media (about 137 MB): the installer imports them when they are there,
# but a clone stays small. assets/emoji.json IS tracked: the clipboard's emoji
# tab reads it at runtime.
assets/wallpapers/
assets/adaptive-wallpapers/
assets/animation-wallpapers/

# --- Review screenshots ---
# Captures taken for review; never committed (they may show the wallpaper).
screenshots/

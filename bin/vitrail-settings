#!/usr/bin/env bash
# Launches the Vitrail settings window.
#
# Paths and the wallpaper palette are injected here: the QML runtime cannot
# read environment variables or local files, and QtCore cannot be imported
# alongside Qt.labs.settings in the same file (Qt 6.11 fails to load).
set -euo pipefail

HERE="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
SHELL_DIR="$(cd -- "${HERE}/../shell" && pwd)"

CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/vitrail"
VPN_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/vitrail-vpn"

# Everything the window writes is its user's alone: the VPN document names
# connections, credentials and rules. Folders 0700, files 0600 from here on.
umask 077

mkdir -p -- "${CONFIG}" "${VPN_DIR}"

# The helpers below do not depend on each other, so they run together, each
# writing its answer to a file in a private folder; `wait` joins them all
# before the window starts. `migrate` (a legacy settings.ini becomes one file
# per area) runs among them: none of the others reads the preference files, and
# only the window does, after the `wait`.

# The bundle is a file, not an argument: every language makes it longer than
# the kernel's 128 KiB limit for one argument. The window reads it at start.
CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/vitrail"
i18n_file="${CACHE_DIR}/i18n-bundle.json"
mkdir -p -- "${CACHE_DIR}"

work="$(mktemp -d)"
trap 'rm -rf -- "${work}"' EXIT

# The time zone page: every zone with its UTC offset, and what the system uses
# now. The window cannot read tzdata or run commands.
zone=""
ntp="yes"
if command -v timedatectl >/dev/null 2>&1; then
    zone="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
    ntp="$(timedatectl show -p NTP --value 2>/dev/null || printf yes)"
fi

if command -v python3 >/dev/null 2>&1; then
    PYTHONPATH="${HERE}/.." python3 -m vitrail.cli migrate >/dev/null 2>&1 &
    {
        PYTHONPATH="${HERE}/.." python3 -m vitrail.plugins index >"${work}/plugins" 2>/dev/null || printf '[]' >"${work}/plugins"
    } &
    {
        if python3 "${HERE}/../scripts/i18n-bundle.py" >"${i18n_file}.part" 2>/dev/null; then
            mv -- "${i18n_file}.part" "${i18n_file}"
        else
            rm -f -- "${i18n_file}.part"
            printf '{"languages":[],"strings":{}}' >"${i18n_file}"
        fi
    } &
    {
        python3 "${HERE}/../scripts/palette-json.py" >"${work}/palette" 2>/dev/null || printf '{}' >"${work}/palette"
    } &
    {
        PYTHONPATH="${HERE}/.." python3 -m vitrail.timezones index "${zone}" >"${work}/zones" 2>/dev/null || printf '[]' >"${work}/zones"
    } &
    # The Connection page: Ethernet, Wi-Fi, VPN and Bluetooth as they are now.
    # Changes the page asks for come back through network-state.json (see
    # vitrail/network.py).
    {
        PYTHONPATH="${HERE}/.." python3 -m vitrail.network state >"${work}/network" 2>/dev/null || printf '{}' >"${work}/network"
    } &
    # The Monitors page: Hyprland's outputs (none when it is not running).
    {
        PYTHONPATH="${HERE}/.." python3 -m vitrail.monitors state >"${work}/monitors" 2>/dev/null \
            || printf '{"available":false,"monitors":[]}' >"${work}/monitors"
    } &
    # The Fonts page: the fonts, icon packs and cursors this machine has, with
    # a preview file per pack and cursor. A file, not an argument: the paths
    # pass the kernel's 128 KiB limit for one argument on a font-heavy machine.
    {
        if PYTHONPATH="${HERE}/.." python3 -m vitrail.fonts state >"${CACHE_DIR}/fonts-state.json.part" 2>/dev/null; then
            mv -- "${CACHE_DIR}/fonts-state.json.part" "${CACHE_DIR}/fonts-state.json"
        else
            rm -f -- "${CACHE_DIR}/fonts-state.json.part"
            printf '{"fonts":[],"monospace":[],"iconThemes":[],"cursorThemes":[],"iconDesigns":[],"iconUser":[],"iconPreviews":{},"cursorPreviews":{}}' \
                >"${CACHE_DIR}/fonts-state.json"
        fi
    } &
    wait
else
    printf '{"languages":[],"strings":{}}' >"${i18n_file}"
fi

# What a helper printed, or `fallback` when it printed nothing.
answer() {
    local text
    text="$(cat -- "${work}/$1" 2>/dev/null || true)"
    printf '%s' "${text:-$2}"
}
plugins="$(answer plugins '[]')"
palette="$(answer palette '{}')"
zones="$(answer zones '[]')"
network="$(answer network '{}')"
monitors="$(answer monitors '{"available":false,"monitors":[]}')"
fonts_file="${CACHE_DIR}/fonts-state.json"
# `exec` below skips the EXIT trap.
rm -rf -- "${work}"

# Adaptive SVG previews read the files to fill their {{role}} placeholders.
export QML_XHR_ALLOW_FILE_READ=1

# The VPN page opens a file dialog for a .ovpn. Under `qt6ct` Qt draws its own
# plain dialog (QtQuick.Dialogs falls back to it); the xdg-desktop-portal
# platform theme sends it to the desktop's file chooser (the portal backend of
# hyprland-portals.conf) instead. Scoped to this window: the rest of the
# session keeps its platform theme.
export QT_QPA_PLATFORMTHEME=xdgdesktopportal

exec qml6 -I "${HERE}/.." "${SHELL_DIR}/main.qml" -- \
    --config "${CONFIG}" \
    --palette "${palette}" \
    --i18n-file "${i18n_file}" \
    --plugins "${plugins}" \
    --zones "${zones}" \
    --timezone "${zone}" \
    --ntp "${ntp}" \
    --network "${network}" \
    --monitors "${monitors}" \
    --fonts-file "${fonts_file}" \
    --home "${HOME}" \
    --runtime "${XDG_RUNTIME_DIR:-}" \
    --vpn "${VPN_DIR}" \
    "$@"

# ~/.config/hypraether/vpn/connections/proton-us.conf
#
# TEMPLATE for the split-tunnel OpenVPN client configuration.
#
# This is what `hypraether-vpn import` generates from a stock provider .ovpn
# file. Do NOT hand-edit the embedded <ca>/<tls-crypt> blocks — they are
# copied verbatim from the .ovpn you download. Instead, keep your .ovpn up
# to date and re-import it.
#
# Key split-tunnel adaptations (compared to a stock .ovpn):
#   - `pull-filter ignore "redirect-gateway"`  : the tunnel must NOT become the
#     system default route; only fwmark 0x4555 traffic is routed into it.
#   - `pull-filter ignore "dhcp-option DNS"`   : keep using the local dnsmasq
#     as resolver so domains keep populating the nftables sets.
#   - `route-nopull`                           : ignore server-pushed routes.
#   - `auth-user-pass /run/hypraether-vpn/<id>/auth.txt` : transient tmpfs
#     credentials written by vpn-auth-prep.sh from the sqlite vault.
#   - `up`/`down` scripts                     : install/remove the policy routing
#     and SNAT rules (see /etc/hypraether/vpn/).
#   - ping/connect-retry options               : resilient auto-reconnect.

client
dev tun
proto udp

# -- BEGIN: copied from your provider's .ovpn -------------------------------
# Replace with the "remote <host> <port>" lines of your chosen servers. To
# auto-pivot across multiple free US nodes (recommended), list ALL of their
# entry IPs and ports here — OpenVPN will iterate them (see remote-random
# below) and connect to the first one that answers. Keep the <ca> and
# <tls-crypt> blocks from one of those files (they are shared Proton infra).
#
# Example: 5 free US servers x 5 ports each = 25 remotes:
remote 149.40.62.51 1194
remote 149.40.62.51 4569
remote 149.22.88.59 1194
remote 149.40.58.145 1194
remote 149.40.51.231 1194
remote 194.180.34.2 1194
# ... add all ports (80, 443, 1194, 4569, 5060, 51820) per server as needed
# -- END: copied from your provider's .ovpn --------------------------------

remote-random
resolv-retry infinite
nobind

cipher AES-256-GCM
setenv CLIENT_CERT 0
tun-mtu 1500
mssfix 0
persist-key
persist-tun

reneg-sec 0
remote-cert-tls server

# -- BEGIN: split-tunnel adaptations (added by ovpn2split.py) ---------------
auth-user-pass /run/hypraether-vpn/proton-us/auth.txt

pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option DNS"
route-nopull

ping 10
ping-restart 60
connect-retry 5 60
connect-timeout 30
explicit-exit-notify
resolv-retry infinite

script-security 2
up /etc/hypraether/vpn/vpn-up.sh
down /etc/hypraether/vpn/vpn-down.sh
# -- END: split-tunnel adaptations ------------------------------------------

# -- BEGIN: cert/key blocks from your provider's .ovpn ----------------------
# <ca>...</ca>
# <tls-crypt>...</tls-crypt>
# -- END: cert/key blocks ---------------------------------------------------

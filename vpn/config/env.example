# /etc/hypraether/vpn/env
#
# Absolute paths to the per-user vault and generated connection configs, so
# the root systemd wrapper (vpn-auth-prep.sh) can find the credentials for
# any hypraether-vpn@<id>.service instance, plus the global traffic mode.
# Written by install.sh with the home of the user that ran it (@VPN_USER@);
# do not edit by hand unless you know what you're doing.
VPN_USER=@VPN_USER@
VPN_VAULT=@VPN_USER_HOME@/.config/hypraether/vpn/vault.db
VPN_CONF_DIR=@VPN_USER_HOME@/.config/hypraether/vpn/connections
# split = only listed domains tunneled; full = everything except listed
# exclusions. Switch with: sudo /etc/hypraether/vpn/vpn-mode.sh <split|full>
VPN_MODE=split
